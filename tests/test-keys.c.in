#include <jansson.h>

/* Fault injection for create_new_keys' rollback: the key paths are
 * random thumbprints, so a save failure at a later key cannot be
 * forced with pre-created files. keys.c's json_dump_file calls are
 * rewritten to this wrapper (the same macro-stub pattern test-pqc.c.in
 * uses for http_reply); the wrapper still performs the real saves
 * until the injected failure point. With json_dump_fail_saved set,
 * the failing call performs its real save too: it simulates a
 * close-time failure after the last write, which leaves a complete,
 * valid key on disk that json_dump_file() nonetheless reports as
 * failed. */
static int json_dump_fail_after = -1;
static int json_dump_calls = 0;
static int json_dump_fail_saved = 0;

static int
test_json_dump_file(const json_t* jwk, const char* path, size_t flags)
{
    int fail = json_dump_fail_after >= 0
        && json_dump_calls++ >= json_dump_fail_after;
    if (fail && !json_dump_fail_saved) {
        return -1;
    }
    int ret = json_dump_file(jwk, path, flags);
    return fail ? -1 : ret;
}

#define json_dump_file test_json_dump_file
#include "keys.c"
#undef json_dump_file
#include "test-util.h"

const char* jwkdir = "@testjwkdir@";

static char*
copy_fixture(void)
{
    char* tmpdir = create_tempdir();
    if (!tmpdir)
        return NULL;
    char cmd[PATH_MAX * 2];
    snprintf(cmd, sizeof(cmd),
             "cp -a '%s'/*.jwk '%s'/ 2>/dev/null;"
             " cp -a '%s'/.*.jwk '%s'/ 2>/dev/null;"
             " cp -a '%s'/empty.jwk '%s'/ 2>/dev/null;"
             " cp -a '%s'/invalid.jwk '%s'/ 2>/dev/null",
             jwkdir, tmpdir, jwkdir, tmpdir,
             jwkdir, tmpdir, jwkdir, tmpdir);
    if (system(cmd) == -1)
        fprintf(stderr, "Warning: failed to copy fixture files\n");
    return tmpdir;
}

struct thp_result {
    const char* thp;
    int valid;
};

struct test_result_int {
    const char* data;
    int expected;
};

static void
verify_keys_permissions(const char* targetdir)
{
    struct stat st;
    struct dirent* d;
    DIR* dir = opendir(targetdir);
    ASSERT(dir);
    char filepath[PATH_MAX];
    const char* pattern = ".jwk";
    while ((d = readdir(dir)) != NULL) {
        if (strcmp(d->d_name, ".") == 0 || strcmp(d->d_name, "..") == 0) {
            continue;
        }

        char* dot = strrchr(d->d_name, '.');
        if (!dot) {
            continue;
        }

        if (strcmp(dot, pattern) == 0) {
            /* Found a file with .jwk extension. */
            if (snprintf(filepath, PATH_MAX, "%s/%s", targetdir, d->d_name) < 0) {
                fprintf(stderr, "Unable to prepare variable with file full path (%s); skipping\n", d->d_name);
                continue;
            }
            filepath[sizeof(filepath) - 1] = '\0';
            ASSERT(stat(filepath, &st) == 0);

            ASSERT_WITH_MSG(st.st_mode & (S_IRUSR | S_IRGRP), "key = %s, missing perm (0%o)", filepath, (S_IRUSR | S_IRGRP));
            int unexpected_perms[] = {
                S_ISUID, /* 04000 set-user-ID */
                S_ISGID, /* 02000 set-group-ID */
                S_IWUSR, /* 00200 write by owner */
                S_IXUSR, /* 00100 execute/search by owner */
                S_IWGRP, /* 00020 write by group */
                S_IXGRP, /* 00010 execute/search by group */
                S_IROTH, /* 00004 read by others */
                S_IWOTH, /* 00002 write by others */
                S_IXOTH, /* 00001 execute/search by others */
                0
            };
            for (int i = 0; unexpected_perms[i] != 0; i++) {
                ASSERT_WITH_MSG((st.st_mode & unexpected_perms[i]) == 0, "key = %s, i = %d, unexpected perm (0%o)", filepath, i, unexpected_perms[i]);
            }

        }
    }
    closedir(dir);
}

static void
test_create_new_keys(void)
{
   __attribute__((cleanup(cleanup_str))) char* newdir = create_tempdir();
    ASSERT(newdir);
    __attribute__((cleanup(cleanup_tang_keys_info))) struct tang_keys_info* tki = read_keys(newdir);
    ASSERT(tki);
    ASSERT(tki->m_keys_count >= 2);

    /* Make sure keys have proper permissions. */
    verify_keys_permissions(newdir);

    remove_tempdir(newdir);
}

/* When the generated key cannot be saved, create_new_keys() must fail
 * instead of leaving a partially created key store, and it must restore
 * the original umask on the way out. */
static void
test_create_new_keys_save_failure(void)
{
    __attribute__((cleanup(cleanup_str))) char* tmpdir = create_tempdir();
    ASSERT(tmpdir);

    /* The target directory does not exist, so saving the key fails. */
    char missing_dir[PATH_MAX];
    snprintf(missing_dir, PATH_MAX, "%s/missing", tmpdir);

    mode_t old_umask = umask(0022);
    ASSERT_WITH_MSG(create_new_keys(missing_dir) == 0,
                    "create_new_keys must fail when the key cannot be saved");
    ASSERT_WITH_MSG(umask(old_umask) == 0022,
                    "create_new_keys must restore the umask on failure");

    remove_tempdir(tmpdir);
}

/* Number of entries in @dirpath besides "." and "..", or -1 when it
 * cannot be opened. */
static int
count_dir_files(const char* dirpath)
{
    DIR* dir = opendir(dirpath);
    if (!dir) {
        return -1;
    }
    int files = 0;
    struct dirent* d;
    while ((d = readdir(dir)) != NULL) {
        if (strcmp(d->d_name, ".") == 0 || strcmp(d->d_name, "..") == 0) {
            continue;
        }
        files++;
    }
    closedir(dir);
    return files;
}

/* The rollback must remove the keys written before a later one fails:
 * a partial key set left behind would look like a populated keydir to
 * the regeneration trigger and wedge the store. The save failure is
 * injected at the write step (see test_json_dump_file above), since
 * key paths are random thumbprints. */
static void
test_create_new_keys_rollback(void)
{
    __attribute__((cleanup(cleanup_str))) char* newdir = create_tempdir();
    ASSERT(newdir);

    mode_t old_umask = umask(0022);
    /* Fail on the second save (ECMR): ES512 is written and must be
     * unlinked again. Both are mandatory keys, so the failure point
     * does not depend on jose's ML-KEM support. */
    json_dump_calls = 0;
    json_dump_fail_after = 1;
    int ret = create_new_keys(newdir);
    json_dump_fail_after = -1;
    ASSERT(ret == 0);
    ASSERT_WITH_MSG(umask(old_umask) == 0022,
                    "create_new_keys must restore the umask on failure");

    /* Nothing was left behind. */
    int files = count_dir_files(newdir);
    ASSERT_WITH_MSG(files == 0, "rollback left %d file(s) behind", files);

    /* The empty keydir means the next read_keys retries the
     * generation instead of wedging. */
    __attribute__((cleanup(cleanup_tang_keys_info))) struct tang_keys_info* tki =
        read_keys(newdir);
    ASSERT(tki);
    ASSERT(tki->m_keys_count >= 2);

    remove_tempdir(newdir);
}

/* A close-time failure after the last write leaves a complete, valid
 * key on disk that json_dump_file() nonetheless reports as failed:
 * the rollback must unlink that one too. With the path recorded only
 * after a successful dump, the key would stay behind unrecorded --
 * an ECMR key left alone would keep the healing trigger quiet (the
 * store "has" a deriving key) while no signer exists, and every
 * request would answer 500. */
static void
test_create_new_keys_rollback_complete_file(void)
{
    __attribute__((cleanup(cleanup_str))) char* newdir = create_tempdir();
    ASSERT(newdir);

    mode_t old_umask = umask(0022);
    /* Fail on the second save (ECMR), performing the real save
     * first: the file is complete on disk when the failure is
     * reported. */
    json_dump_calls = 0;
    json_dump_fail_after = 1;
    json_dump_fail_saved = 1;
    int ret = create_new_keys(newdir);
    json_dump_fail_after = -1;
    json_dump_fail_saved = 0;
    ASSERT(ret == 0);
    ASSERT_WITH_MSG(umask(old_umask) == 0022,
                    "create_new_keys must restore the umask on failure");

    /* Nothing was left behind, the complete-but-failed key
     * included. */
    int files = count_dir_files(newdir);
    ASSERT_WITH_MSG(files == 0, "rollback left %d file(s) behind", files);

    /* The empty keydir means the next read_keys retries the
     * generation instead of wedging. */
    __attribute__((cleanup(cleanup_tang_keys_info))) struct tang_keys_info* tki =
        read_keys(newdir);
    ASSERT(tki);
    ASSERT(tki->m_keys_count >= 2);

    remove_tempdir(newdir);
}

static void
test_is_hash(void)
{
    const struct test_result_int test_data[] = {
        {NULL, 0},
        {"", 0},
        {"ES512", 0},
        {"ECMR", 0},
        {"foobar", 0},
        {"{", 0},
        {"[}", 0},
        {"[]", 0},
        {"S1", 1},
        {"S224", 1},
        {"S256", 1},
        {"S384", 1},
        {"S512", 1},
        {"S42", 0}
    };
    for (int i = 0, len = ARRAY_COUNT(test_data); i < len; i++) {
        int ret = is_hash(test_data[i].data);
        ASSERT_WITH_MSG(ret == test_data[i].expected, "i = %d, alg = %s", i, test_data[i].data);
    };

}

static void
test_is_valid_kem_alg(void)
{
    const struct test_result_int test_data[] = {
        {NULL, 0},
        {"", 0},
        {"ECMR", 0},
        {"ES512", 0},
        {"ML-DSA-65", 0},
        {"ML-KEM-", 0},
        {"ML-KEM-512x", 0},
        {"ml-kem-768", 0},
        {KEM_ALG_512, 1},
        {KEM_ALG_768, 1},
        {KEM_ALG_1024, 1}
    };

    for (int i = 0, len = ARRAY_COUNT(test_data); i < len; i++) {
        int ret = is_valid_kem_alg(test_data[i].data);
        ASSERT_WITH_MSG(ret == test_data[i].expected, "i = %d, alg = %s", i, test_data[i].data);
    }
}

static void
test_jwk_generate(void)
{
    const struct test_result_int test_data[] = {
        {NULL, 0},
        {"", 0},
        {"ES512", 1},
        {"ECMR", 1},
        {"foobar", 0},
        {"{", 0},
        {"[}", 0},
        {"[]", 0}
    };

    for (int i = 0, len = ARRAY_COUNT(test_data); i < len; i++) {
        json_auto_t* jwk = jwk_generate(test_data[i].data);
        ASSERT_WITH_MSG(!!jwk == test_data[i].expected, "i = %d, alg = %s", i, test_data[i].data);
    };
}

static void
test_find_jws(void)
{
    const struct thp_result test_data[] = {
        {"00BUQM4A7NYxbOrBR9QDfkzGVGj3k57Fs4jCbJxcLYAgRFHu5B7jtbL97x1T7stQ", 1},
        {"dd5qbN1lQ6UWdZszbfx2oIcH34ShklzFL1SUQg", 1},
        {"dOZkUtZ_gLDUP53GIlyAxHMNuyrk8vdY-XXND32GccqNbT_MKpqGC-13-GNEye48", 1},
        {"DZrlBQvfvlwPQlvH_IieBdc_KpesEramLygVL_rFr7g", 1},
        {"FL_Zt5fFadUL4syeMMpUnss8aKdCrPGFy3102JGR3EE", 1},
        {"qgmqJSo6AEEuVQY7zVlklqdTMqY", 1},
        {"r4E2wG1u_YyKUo0N0rIK7jJF5Xg", 1},
        {"ugJ4Ula-YABQIiJ-0g3B_jpFpF2nl3W-DNpfLdXArhTusV0QCcd1vtgDeGHEPzpm7jEsyC7VYYSSOkZicK22mw", 1},
        {"up0Z4fRhpd4O5QwBaMCXDTlrvxCmZacU0MD8kw", 1},
        {"vllHS-M0aQFCo2yUCcAahMU4TAtXACyeuRf-zbmmTPBg7V0Pb-RRFGo5C6MnpzdirK8B3ORLOsN8RyXClvtjxA", 1},
        {"-bWkGaJi0Zdvxaj4DCp28umLcRA", 0},
        {"WEpfFyeoNKkE2-TosN_bP-gd9UgRvQCZpVasZQ", 0},
        {"L4xg2tZXTEVbsK39bzOZM1jGWn3HtOxF5gh6F9YVf5Q", 0},
        {"9U8qgy_YjyY6Isuq6QuiKEiYZgNJShcGgJx5FJzCu6m3N6zFaIPy_HDkxkVqAZ9E", 0},
        {"Cy73glFjs6B6RU7wy6vWxAc-2bJy5VJOT9LyK80eKgZ8k27wXZ-3rjsuNU5tua_yHWtluyoSYtjoKXfI0E8ESw", 0},
        {NULL, 1},
        {"a", 0},
        {"foo", 0},
        {"bar", 0},
        {"XXXXXXXXXXXXXXXXXX", 0}
    };

    __attribute__((cleanup(cleanup_str))) char* tmpdir = copy_fixture();
    ASSERT(tmpdir);

    /* Passing NULL tki must fail cleanly. */
    ASSERT(find_jws(NULL, "foo") == NULL);

    __attribute__((cleanup(cleanup_tang_keys_info))) struct tang_keys_info* tki = read_keys(tmpdir);
    for (int i = 0, len = ARRAY_COUNT(test_data); i < len; i++) {
        json_auto_t* jws = find_jws(tki, test_data[i].thp);
        ASSERT_WITH_MSG(!!jws == test_data[i].valid, "i = %d, thp = %s", i, test_data[i].thp);
    }

    /* Passing NULL to find_jws should return the default advertisement */
    json_auto_t* adv = find_jws(tki, NULL);
    ASSERT(adv);


    /*
     * The default set of signing keys are the signing keys that are not
     * rotated. The payload is made of deriving keys that are also not
     * rotated. The default advertisement should be signed by this set of
     * default signing keys.
     */
    ASSERT(jose_jws_ver(NULL, adv, NULL, tki->m_sign, 1));

    /* find_jws should be able to respond to thumbprints of keys using any
     * of jose supported hash algorithms. */
    const char** hashes = supported_hashes();
    size_t idx;
    json_t* jwk;

    /* Let's put together all the keys, including rotated ones. */
    json_auto_t* keys = json_deep_copy(tki->m_keys);
    ASSERT(keys);
    ASSERT(json_array_extend(keys, tki->m_rotated_keys) == 0);
    ASSERT(json_array_size(keys) == (size_t)(tki->m_keys_count + tki->m_rotated_keys_count));

    for (int i = 0; hashes[i]; i++) {
        json_array_foreach(keys, idx, jwk) {
            if (!jwk_valid_for_signing(jwk)) {
                continue;
            }
            __attribute__((cleanup(cleanup_str))) char* thp = jwk_thumbprint(jwk, hashes[i]);
            ASSERT_WITH_MSG(thp, "i = %d, hash = %s, key idx = %d", i, hashes[i], idx);
            json_auto_t* jws = find_jws(tki, thp);
            ASSERT_WITH_MSG(jws, "i = %d, hash = %s, key idx = %d, thp = %s", i, hashes[i], idx, thp);

            /* Signing keys should sign the payload, in addition to the
             * default set of signing keys. */
            json_auto_t* sign = json_deep_copy(tki->m_sign);
            ASSERT_WITH_MSG(sign, "i = %d, hash = %s, key idx = %d, thp = %s", i, hashes[i], idx, thp);
            ASSERT_WITH_MSG(json_array_append(sign, jwk) == 0, "i = %d, hash = %s, key idx = %d, thp = %s", i, hashes[i], idx, thp);
            ASSERT_WITH_MSG(jose_jws_ver(NULL, jws, NULL, sign, 1), "i = %d, hash = %s, key idx = %d, thp = %s", i, hashes[i], idx, thp);
        }
    }
    remove_tempdir(tmpdir);
}

static void
test_find_jwk(void)
{
    const struct thp_result test_data[] = {
        {"1HdF3XKRSsuZdkpXNurBPoL_pvxdvCOlHuhB4DP-4xWFqbZ51zo29kR4fSiT3BGy9UrHVJ26JMBLOA1vKq3lxA", 1},
        {"9U8qgy_YjyY6Isuq6QuiKEiYZgNJShcGgJx5FJzCu6m3N6zFaIPy_HDkxkVqAZ9E", 1},
        {"-bWkGaJi0Zdvxaj4DCp28umLcRA", 1},
        {"Cy73glFjs6B6RU7wy6vWxAc-2bJy5VJOT9LyK80eKgZ8k27wXZ-3rjsuNU5tua_yHWtluyoSYtjoKXfI0E8ESw", 1},
        {"kfjbqx_b3BsgPC87HwlOWL9daGMMHBzxcFLClw", 1},
        {"L4xg2tZXTEVbsK39bzOZM1jGWn3HtOxF5gh6F9YVf5Q", 1},
        {"LsVAV2ig5LlfstM8TRSf-c7IAkLpNYbIysNuRCVlxocRCGqAh6-f9PklM4nU4N-J", 1},
        {"OkAcDxYHNlo7-tul8OubYuWXB8CPEhAkcacCmhTclMU", 1},
        {"uZ0s8YTXcGcuWduWWBSiR2OjOVg", 1},
        {"WEpfFyeoNKkE2-TosN_bP-gd9UgRvQCZpVasZQ", 1},
        {NULL, 0},
        {"a", 0},
        {"foo", 0},
        {"bar", 0},
        {"XXXXXXXXXXXXXXXXXX", 0},
    };

    __attribute__((cleanup(cleanup_str))) char* tmpdir = copy_fixture();
    ASSERT(tmpdir);
    __attribute__((cleanup(cleanup_tang_keys_info))) struct tang_keys_info* tki = read_keys(tmpdir);

    for (int i = 0, len = ARRAY_COUNT(test_data); i < len; i++) {
        json_auto_t* tjwk = find_jwk(tki, test_data[i].thp);
        ASSERT_WITH_MSG(!!tjwk == test_data[i].valid, "i = %d, thp = %s", i, test_data[i].thp);
    }
    /* Passing NULL to find_jwk should fail */
    json_auto_t* bad_jwk = find_jwk(tki, NULL);
    ASSERT(bad_jwk == NULL);

    /* find_jwk should be able to respond to thumbprints of keys using any
     * of jose supported hash algorithms. */
    const char** hashes = supported_hashes();
    size_t idx;
    json_t* jwk;

    /* Let's put together all the keys, including rotated ones. */
    json_auto_t* keys = json_deep_copy(tki->m_keys);
    ASSERT(keys);
    ASSERT(json_array_extend(keys, tki->m_rotated_keys) == 0);
    ASSERT(json_array_size(keys) == (size_t)(tki->m_keys_count + tki->m_rotated_keys_count));

    for (int i = 0; hashes[i]; i++) {
        json_array_foreach(keys, idx, jwk) {
            if (!jwk_valid_for_ecmr_recovery(jwk)) {
                continue;
            }
            __attribute__((cleanup(cleanup_str))) char* thp = jwk_thumbprint(jwk, hashes[i]);
            json_auto_t* tjwk = find_jwk(tki, thp);
            ASSERT_WITH_MSG(tjwk, "i = %d, hash = %s, key idx = %d, thp = %s", i, hashes[i], idx, thp);
        }
    }
    remove_tempdir(tmpdir);
}

static void
test_read_keys(void)
{
    __attribute__((cleanup(cleanup_str))) char* tmpdir = copy_fixture();
    ASSERT(tmpdir);

    /* Files without the .jwk extension must be ignored by the key store. */
    char ignored_path[PATH_MAX];
    snprintf(ignored_path, PATH_MAX, "%s/README", tmpdir);
    FILE* ignored = fopen(ignored_path, "w");
    ASSERT_WITH_MSG(ignored, "path = %s", ignored_path);
    ASSERT(fputs("not a key\n", ignored) >= 0);
    ASSERT(fclose(ignored) == 0);

    __attribute__((cleanup(cleanup_tang_keys_info))) struct tang_keys_info* tki = read_keys(tmpdir);
    ASSERT(tki);

    /*
     * Original keys in tests/keys:
     * - .uZ0s8YTXcGcuWduWWBSiR2OjOVg.jwk  (rotated)
     * - .r4E2wG1u_YyKUo0N0rIK7jJF5Xg.jwk  (rotated)
     * - qgmqJSo6AEEuVQY7zVlklqdTMqY.jwk   (active)
     * - -bWkGaJi0Zdvxaj4DCp28umLcRA.jwk    (active)
     */
    ASSERT(tki->m_keys_count == 2);
    ASSERT(tki->m_rotated_keys_count == 2);
    ASSERT(json_array_size(tki->m_keys) == 2);
    ASSERT(json_array_size(tki->m_rotated_keys) == 2);

    const char* invalid_jwkdir = "foobar";
    __attribute__((cleanup(cleanup_tang_keys_info))) struct tang_keys_info* tki2 = read_keys(invalid_jwkdir);
    ASSERT(tki2 == NULL);

    remove_tempdir(tmpdir);
}

static void
test_cleanup_null(void)
{
    free_tang_keys_info(NULL);
    cleanup_tang_keys_info(NULL);
    struct tang_keys_info* null_tki = NULL;
    cleanup_tang_keys_info(&null_tki);
}

static void
test_jwk_sign_null_inputs(void)
{
    ASSERT(jwk_sign(NULL, NULL) == NULL);

    json_auto_t* arr = json_array();
    ASSERT(jwk_sign(arr, NULL) == NULL);
    ASSERT(jwk_sign(NULL, arr) == NULL);

    json_auto_t* obj = json_object();
    ASSERT(jwk_sign(obj, arr) == NULL);
    ASSERT(jwk_sign(arr, obj) == NULL);
}

/* jwk_sign() must fail cleanly when none of the provided keys can sign. */
static void
test_jwk_sign_no_signing_key(void)
{
    json_auto_t* payload = json_array();
    ASSERT(payload);
    json_auto_t* sig = jwk_generate("ES512");
    ASSERT(sig);
    ASSERT(json_array_append(payload, sig) == 0);

    json_auto_t* sig_keys = json_array();
    ASSERT(sig_keys);
    json_auto_t* exc = jwk_generate("ECMR");
    ASSERT(exc);
    ASSERT(json_array_append(sig_keys, exc) == 0);

    ASSERT_WITH_MSG(jwk_sign(payload, sig_keys) == NULL,
                    "jwk_sign must fail when no key can sign");
}

static void
test_read_keys_with_kem(void)
{
    const char* kem_algs[] = {"ML-KEM-512", "ML-KEM-768", "ML-KEM-1024", NULL};
    int kem_count = 0;
    mode_t old_umask = umask(0022);
    __attribute__((cleanup(cleanup_str))) char* newdir = create_tempdir();
    ASSERT(newdir);

    json_auto_t* sig = jwk_generate("ES512");
    ASSERT(sig);
    __attribute__((cleanup(cleanup_str))) char* sig_thp = jwk_thumbprint(sig, "S256");
    ASSERT(sig_thp);
    char sig_path[PATH_MAX];
    snprintf(sig_path, PATH_MAX, "%s/%s.jwk", newdir, sig_thp);
    ASSERT(json_dump_file(sig, sig_path, 0) == 0);

    json_auto_t* exc = jwk_generate("ECMR");
    ASSERT(exc);
    __attribute__((cleanup(cleanup_str))) char* exc_thp = jwk_thumbprint(exc, "S256");
    ASSERT(exc_thp);
    char exc_path[PATH_MAX];
    snprintf(exc_path, PATH_MAX, "%s/%s.jwk", newdir, exc_thp);
    ASSERT(json_dump_file(exc, exc_path, 0) == 0);

    for (int i = 0; kem_algs[i]; i++) {
        json_auto_t* kem = jwk_generate(kem_algs[i]);
        if (!kem) {
            fprintf(stderr, "Skipping %s (not supported)\n", kem_algs[i]);
            continue;
        }
        __attribute__((cleanup(cleanup_str))) char* kem_thp =
            jwk_thumbprint(kem, "S256");
        ASSERT(kem_thp);
        char kem_path[PATH_MAX];
        snprintf(kem_path, PATH_MAX, "%s/%s.jwk", newdir, kem_thp);
        ASSERT(json_dump_file(kem, kem_path, 0) == 0);
        kem_count++;
    }

    if (kem_count == 0) {
        fprintf(stderr, "Skipping KEM tests (no ML-KEM variant supported)\n");
        remove_tempdir(newdir);
        umask(old_umask);
        return;
    }

    __attribute__((cleanup(cleanup_tang_keys_info))) struct tang_keys_info* tki =
        read_keys(newdir);
    ASSERT(tki);
    ASSERT(tki->m_keys_count == (size_t)(2 + kem_count));
    ASSERT(tki->m_has_pqc == 1);
    ASSERT(json_array_size(tki->m_kem_payload) == (size_t)kem_count);
    ASSERT(json_array_size(tki->m_payload) == 2);

    /* Verify each KEM key has a distinct ML-KEM algorithm. */
    size_t idx;
    json_t* jwk;
    const char* seen[3] = {NULL, NULL, NULL};
    int seen_count = 0;
    json_array_foreach(tki->m_kem_payload, idx, jwk) {
        const char* alg = json_string_value(json_object_get(jwk, "alg"));
        ASSERT(alg);
        ASSERT(strncmp(alg, "ML-KEM-", 7) == 0);
        for (int j = 0; j < seen_count; j++) {
            ASSERT_WITH_MSG(strcmp(seen[j], alg) != 0,
                "Duplicate KEM alg: %s", alg);
        }
        ASSERT(seen_count < 3);
        seen[seen_count++] = alg;
    }

    remove_tempdir(newdir);
    umask(old_umask);
}

static void
test_create_new_keys_kem_variants(void)
{
    __attribute__((cleanup(cleanup_str))) char* newdir = create_tempdir();
    ASSERT(newdir);
    __attribute__((cleanup(cleanup_tang_keys_info))) struct tang_keys_info* tki =
        read_keys(newdir);
    ASSERT(tki);
    ASSERT(tki->m_keys_count >= 2);

    if (!tki->m_has_pqc) {
        fprintf(stderr, "No PQC support, skipping KEM variant test\n");
        remove_tempdir(newdir);
        return;
    }

    ASSERT(json_array_size(tki->m_kem_payload) >= 1);

    size_t idx;
    json_t* jwk;
    const char* seen[3] = {NULL, NULL, NULL};
    int seen_count = 0;
    json_array_foreach(tki->m_kem_payload, idx, jwk) {
        const char* alg = json_string_value(json_object_get(jwk, "alg"));
        ASSERT(alg);
        ASSERT(strncmp(alg, "ML-KEM-", 7) == 0);
        for (int j = 0; j < seen_count; j++) {
            ASSERT_WITH_MSG(strcmp(seen[j], alg) != 0,
                "Duplicate KEM alg: %s", alg);
        }
        ASSERT(seen_count < 3);
        seen[seen_count++] = alg;
    }

    verify_keys_permissions(newdir);
    remove_tempdir(newdir);
}

static void
test_jwk_thumbprint_edge_cases(void)
{
    ASSERT(jwk_thumbprint(NULL, "S256") == NULL);

    json_auto_t *jwk = jwk_generate("ES512");
    ASSERT(jwk);

    ASSERT(jwk_thumbprint(jwk, NULL) == NULL);
    ASSERT(jwk_thumbprint(jwk, "") == NULL);
    ASSERT(jwk_thumbprint(jwk, "INVALID") == NULL);

    const char **hashes = supported_hashes();
    for (int i = 0; hashes[i]; i++) {
        __attribute__((cleanup(cleanup_str))) char *thp =
            jwk_thumbprint(jwk, hashes[i]);
        ASSERT_WITH_MSG(thp, "hash = %s", hashes[i]);
        ASSERT(strlen(thp) > 0);
    }
}

/* A JWK missing its thumbprint members (here an EC key without x/y)
 * parses fine, so load_keys accepts it and it reaches find_by_thp in
 * production. jose_jwk_thp_buf signals failure with SIZE_MAX, which
 * is truthy: the != dlen comparison is what catches it, and without
 * it the uninitialized digest buffer would be base64-encoded into a
 * garbage thumbprint. */
static void
test_jwk_thumbprint_missing_members(void)
{
    json_auto_t* ec = json_pack("{s:s, s:s}", "kty", "EC", "crv", "P-521");
    ASSERT(ec);
    ASSERT_WITH_MSG(jwk_thumbprint(ec, "S256") == NULL,
                    "an EC key without x/y has no thumbprint");

    /* The same JWK in the store must not break key lookups: the
     * failing thumbprint is skipped and good keys are still found. */
    mode_t old_umask = umask(0022);
    __attribute__((cleanup(cleanup_str))) char* newdir = create_tempdir();
    ASSERT(newdir);

    json_auto_t* sig = jwk_generate("ES512");
    ASSERT(sig);
    char sig_path[PATH_MAX];
    snprintf(sig_path, PATH_MAX, "%s/sig.jwk", newdir);
    ASSERT(json_dump_file(sig, sig_path, 0) == 0);

    /* A complete deriving key: without it, the broken key below would
     * count as "no usable deriving key" and the healing trigger would
     * regenerate a full key set, which is not what this test is
     * about. */
    json_auto_t* exc = jwk_generate("ECMR");
    ASSERT(exc);
    char exc_path[PATH_MAX];
    snprintf(exc_path, PATH_MAX, "%s/exc.jwk", newdir);
    ASSERT(json_dump_file(exc, exc_path, 0) == 0);

    json_auto_t* broken = json_pack("{s:s, s:s, s:[s]}",
                                    "kty", "EC", "crv", "P-521",
                                    "key_ops", "deriveKey");
    ASSERT(broken);
    char broken_path[PATH_MAX];
    snprintf(broken_path, PATH_MAX, "%s/broken.jwk", newdir);
    ASSERT(json_dump_file(broken, broken_path, 0) == 0);

    __attribute__((cleanup(cleanup_tang_keys_info))) struct tang_keys_info* tki =
        read_keys(newdir);
    ASSERT(tki);
    ASSERT(tki->m_keys_count == 3);
    ASSERT(find_jwk(tki, "nonexistent-thumbprint") == NULL);

    __attribute__((cleanup(cleanup_str))) char* sig_thp =
        jwk_thumbprint(sig, "S256");
    ASSERT(sig_thp);
    json_auto_t* found = find_jwk(tki, sig_thp);
    ASSERT_WITH_MSG(found && json_equal(found, sig),
                    "the good key must still be found");

    remove_tempdir(newdir);
    umask(old_umask);
}

/* A partially-populated store -- what an interrupted auto-generation
 * leaves behind -- must not wedge the server: with signing keys but
 * no deriving key, the advertisement looks healthy yet no client
 * could ever recover. read_keys treats it like an empty store and
 * regenerates; a second run against the healed store must be stable,
 * with no further regeneration. */
static void
test_read_keys_partial_store_regenerates(void)
{
    mode_t old_umask = umask(0022);
    __attribute__((cleanup(cleanup_str))) char* newdir = create_tempdir();
    ASSERT(newdir);

    json_auto_t* sig = jwk_generate("ES512");
    ASSERT(sig);
    char sig_path[PATH_MAX];
    snprintf(sig_path, PATH_MAX, "%s/sig.jwk", newdir);
    ASSERT(json_dump_file(sig, sig_path, 0) == 0);

    /* First run: the missing deriving key triggers a regeneration. */
    __attribute__((cleanup(cleanup_tang_keys_info))) struct tang_keys_info* tki =
        read_keys(newdir);
    ASSERT(tki);
    ASSERT_WITH_MSG(tki->m_keys_count >= 2,
                    "the deriving key must be regenerated, got %zu keys",
                    tki->m_keys_count);

    size_t idx;
    json_t* jwk;
    int has_deriving = 0;
    json_array_foreach(tki->m_payload, idx, jwk) {
        if (jwk_valid_for_ecmr_recovery(jwk)) {
            has_deriving = 1;
            break;
        }
    }
    ASSERT_WITH_MSG(has_deriving,
                    "no deriving key in the regenerated payload");

    /* Second run: stable, no further regeneration. */
    __attribute__((cleanup(cleanup_tang_keys_info))) struct tang_keys_info* tki2 =
        read_keys(newdir);
    ASSERT(tki2);
    ASSERT_WITH_MSG(tki2->m_keys_count == tki->m_keys_count,
                    "second read_keys regenerated again: %zu vs %zu",
                    tki2->m_keys_count, tki->m_keys_count);

    remove_tempdir(newdir);
    umask(old_umask);
}

/* A public-only ECMR key (e.g. the output of "jose jwk pub", which
 * preserves key_ops) must not be advertised: clients would bind to
 * it, since encapsulation only needs crv/x/y, but every later /rec
 * needs the private half and could only fail with 403. With a
 * complete deriving key present the store is fine, so no healing is
 * expected either. */
static void
test_read_keys_public_only_exc_not_advertised(void)
{
    mode_t old_umask = umask(0022);
    __attribute__((cleanup(cleanup_str))) char* newdir = create_tempdir();
    ASSERT(newdir);

    json_auto_t* sig = jwk_generate("ES512");
    ASSERT(sig);
    char sig_path[PATH_MAX];
    snprintf(sig_path, PATH_MAX, "%s/sig.jwk", newdir);
    ASSERT(json_dump_file(sig, sig_path, 0) == 0);

    json_auto_t* exc = jwk_generate("ECMR");
    ASSERT(exc);
    __attribute__((cleanup(cleanup_str))) char* exc_thp =
        jwk_thumbprint(exc, "S256");
    ASSERT(exc_thp);
    char exc_path[PATH_MAX];
    snprintf(exc_path, PATH_MAX, "%s/%s.jwk", newdir, exc_thp);
    ASSERT(json_dump_file(exc, exc_path, 0) == 0);

    json_auto_t* pub_only = jwk_generate("ECMR");
    ASSERT(pub_only);
    json_object_del(pub_only, "d");
    __attribute__((cleanup(cleanup_str))) char* pub_only_thp =
        jwk_thumbprint(pub_only, "S256");
    ASSERT(pub_only_thp);
    char pub_only_path[PATH_MAX];
    snprintf(pub_only_path, PATH_MAX, "%s/%s.jwk", newdir, pub_only_thp);
    ASSERT(json_dump_file(pub_only, pub_only_path, 0) == 0);

    __attribute__((cleanup(cleanup_tang_keys_info))) struct tang_keys_info* tki =
        read_keys(newdir);
    ASSERT(tki);
    /* The complete deriving key keeps the healing trigger quiet. */
    ASSERT(tki->m_keys_count == 3);

    size_t idx;
    json_t* jwk;
    int has_complete_exc = 0;
    json_array_foreach(tki->m_payload, idx, jwk) {
        __attribute__((cleanup(cleanup_str))) char* thp =
            jwk_thumbprint(jwk, "S256");
        ASSERT_WITH_MSG(thp && strcmp(thp, pub_only_thp) != 0,
                        "public-only ECMR key advertised in the payload");
        if (thp && strcmp(thp, exc_thp) == 0) {
            has_complete_exc = 1;
        }
    }
    ASSERT_WITH_MSG(has_complete_exc,
                    "complete ECMR key missing from the payload");

    remove_tempdir(newdir);
    umask(old_umask);
}

/* The same store without a complete deriving key: the healing trigger
 * counts usable deriving keys only, so a public-only ECMR key no
 * longer masks a store that cannot serve recovery, and read_keys
 * repairs it. */
static void
test_read_keys_public_only_exc_heals(void)
{
    mode_t old_umask = umask(0022);
    __attribute__((cleanup(cleanup_str))) char* newdir = create_tempdir();
    ASSERT(newdir);

    json_auto_t* sig = jwk_generate("ES512");
    ASSERT(sig);
    char sig_path[PATH_MAX];
    snprintf(sig_path, PATH_MAX, "%s/sig.jwk", newdir);
    ASSERT(json_dump_file(sig, sig_path, 0) == 0);

    json_auto_t* pub_only = jwk_generate("ECMR");
    ASSERT(pub_only);
    json_object_del(pub_only, "d");
    __attribute__((cleanup(cleanup_str))) char* pub_only_thp =
        jwk_thumbprint(pub_only, "S256");
    ASSERT(pub_only_thp);
    char pub_only_path[PATH_MAX];
    snprintf(pub_only_path, PATH_MAX, "%s/pubonly.jwk", newdir);
    ASSERT(json_dump_file(pub_only, pub_only_path, 0) == 0);

    __attribute__((cleanup(cleanup_tang_keys_info))) struct tang_keys_info* tki =
        read_keys(newdir);
    ASSERT_WITH_MSG(tki, "read_keys must heal the store, not fail");
    /* The regenerated full key set was added alongside. */
    ASSERT_WITH_MSG(tki->m_keys_count >= 4,
                    "store not healed: %zu keys", tki->m_keys_count);

    size_t idx;
    json_t* jwk;
    int has_deriving = 0;
    json_array_foreach(tki->m_payload, idx, jwk) {
        __attribute__((cleanup(cleanup_str))) char* thp =
            jwk_thumbprint(jwk, "S256");
        ASSERT_WITH_MSG(thp && strcmp(thp, pub_only_thp) != 0,
                        "public-only ECMR key advertised in the payload");
        if (jwk_valid_for_ecmr_recovery(jwk)) {
            has_deriving = 1;
        }
    }
    ASSERT_WITH_MSG(has_deriving,
                    "healed store has no usable deriving key");

    remove_tempdir(newdir);
    umask(old_umask);
}

/* A hand-edited ECMR key with its alg removed -- key_ops and d kept,
 * so the permission and material checks alone would admit it -- must
 * not be advertised: /rec and /rec-kem require alg ECMR, so clients
 * binding to it could never recover. With a complete ECMR key present
 * the store is fine, so no healing is expected either. */
static void
test_read_keys_alg_removed_exc_not_advertised(void)
{
    mode_t old_umask = umask(0022);
    __attribute__((cleanup(cleanup_str))) char* newdir = create_tempdir();
    ASSERT(newdir);

    json_auto_t* sig = jwk_generate("ES512");
    ASSERT(sig);
    char sig_path[PATH_MAX];
    snprintf(sig_path, PATH_MAX, "%s/sig.jwk", newdir);
    ASSERT(json_dump_file(sig, sig_path, 0) == 0);

    json_auto_t* exc = jwk_generate("ECMR");
    ASSERT(exc);
    __attribute__((cleanup(cleanup_str))) char* exc_thp =
        jwk_thumbprint(exc, "S256");
    ASSERT(exc_thp);
    char exc_path[PATH_MAX];
    snprintf(exc_path, PATH_MAX, "%s/%s.jwk", newdir, exc_thp);
    ASSERT(json_dump_file(exc, exc_path, 0) == 0);

    json_auto_t* no_alg = jwk_generate("ECMR");
    ASSERT(no_alg);
    json_object_del(no_alg, "alg");
    __attribute__((cleanup(cleanup_str))) char* no_alg_thp =
        jwk_thumbprint(no_alg, "S256");
    ASSERT(no_alg_thp);
    char no_alg_path[PATH_MAX];
    snprintf(no_alg_path, PATH_MAX, "%s/%s.jwk", newdir, no_alg_thp);
    ASSERT(json_dump_file(no_alg, no_alg_path, 0) == 0);

    __attribute__((cleanup(cleanup_tang_keys_info))) struct tang_keys_info* tki =
        read_keys(newdir);
    ASSERT(tki);
    /* The complete ECMR key keeps the healing trigger quiet. */
    ASSERT(tki->m_keys_count == 3);

    size_t idx;
    json_t* jwk;
    int has_complete_exc = 0;
    json_array_foreach(tki->m_payload, idx, jwk) {
        __attribute__((cleanup(cleanup_str))) char* thp =
            jwk_thumbprint(jwk, "S256");
        ASSERT_WITH_MSG(thp && strcmp(thp, no_alg_thp) != 0,
                        "ECMR key without alg advertised in the payload");
        if (thp && strcmp(thp, exc_thp) == 0) {
            has_complete_exc = 1;
        }
    }
    ASSERT_WITH_MSG(has_complete_exc,
                    "complete ECMR key missing from the payload");

    remove_tempdir(newdir);
    umask(old_umask);
}

/* The same store without a complete ECMR key: the healing trigger
 * counts keys the shared recovery predicate accepts, so an alg-less
 * key no longer masks a store that cannot serve recovery, and
 * read_keys repairs it. */
static void
test_read_keys_alg_removed_exc_heals(void)
{
    mode_t old_umask = umask(0022);
    __attribute__((cleanup(cleanup_str))) char* newdir = create_tempdir();
    ASSERT(newdir);

    json_auto_t* sig = jwk_generate("ES512");
    ASSERT(sig);
    char sig_path[PATH_MAX];
    snprintf(sig_path, PATH_MAX, "%s/sig.jwk", newdir);
    ASSERT(json_dump_file(sig, sig_path, 0) == 0);

    json_auto_t* no_alg = jwk_generate("ECMR");
    ASSERT(no_alg);
    json_object_del(no_alg, "alg");
    __attribute__((cleanup(cleanup_str))) char* no_alg_thp =
        jwk_thumbprint(no_alg, "S256");
    ASSERT(no_alg_thp);
    char no_alg_path[PATH_MAX];
    snprintf(no_alg_path, PATH_MAX, "%s/noalg.jwk", newdir);
    ASSERT(json_dump_file(no_alg, no_alg_path, 0) == 0);

    __attribute__((cleanup(cleanup_tang_keys_info))) struct tang_keys_info* tki =
        read_keys(newdir);
    ASSERT_WITH_MSG(tki, "read_keys must heal the store, not fail");
    /* The regenerated full key set was added alongside. */
    ASSERT_WITH_MSG(tki->m_keys_count >= 4,
                    "store not healed: %zu keys", tki->m_keys_count);

    size_t idx;
    json_t* jwk;
    int has_ecmr_recovery = 0;
    json_array_foreach(tki->m_payload, idx, jwk) {
        __attribute__((cleanup(cleanup_str))) char* thp =
            jwk_thumbprint(jwk, "S256");
        ASSERT_WITH_MSG(thp && strcmp(thp, no_alg_thp) != 0,
                        "ECMR key without alg advertised in the payload");
        if (jwk_valid_for_ecmr_recovery(jwk)) {
            has_ecmr_recovery = 1;
        }
    }
    ASSERT_WITH_MSG(has_ecmr_recovery,
                    "healed store has no usable ECMR recovery key");

    remove_tempdir(newdir);
    umask(old_umask);
}

static void
test_prepare_payload_and_sign_null(void)
{
    ASSERT(prepare_payload_and_sign(NULL) == 0);
}

/* Regression test: AKP keys must never fall through to the classical
 * payload or the signing set, whatever their alg or key_ops are.
 * RFC 9864 puts ML-DSA in the same kty as ML-KEM, so an operator
 * dropping an AKP signature key (or any AKP key jose cannot classify)
 * into JWKDIR must not break advertisement. */
static void
test_read_keys_with_rogue_akp(void)
{
    mode_t old_umask = umask(0022);
    __attribute__((cleanup(cleanup_str))) char* newdir = create_tempdir();
    ASSERT(newdir);

    json_auto_t* sig = jwk_generate("ES512");
    ASSERT(sig);
    char sig_path[PATH_MAX];
    snprintf(sig_path, PATH_MAX, "%s/sig.jwk", newdir);
    ASSERT(json_dump_file(sig, sig_path, 0) == 0);

    json_auto_t* exc = jwk_generate("ECMR");
    ASSERT(exc);
    char exc_path[PATH_MAX];
    snprintf(exc_path, PATH_MAX, "%s/exc.jwk", newdir);
    ASSERT(json_dump_file(exc, exc_path, 0) == 0);

    /* AKP key with a non-KEM algorithm (ML-DSA) claiming deriveKey. */
    json_auto_t* rogue =
        json_pack("{s:s,s:s,s:[s]}", "kty", "AKP", "alg", "ML-DSA-65",
                  "key_ops", "deriveKey");
    ASSERT(rogue);
    char rogue_path[PATH_MAX];
    snprintf(rogue_path, PATH_MAX, "%s/rogue_akp.jwk", newdir);
    ASSERT(json_dump_file(rogue, rogue_path, 0) == 0);

    /* AKP ML-KEM key with no use/key_ops at all: jose treats an
     * unrestricted key as permitted for every operation when
     * req = false, but /rec-kem recovers with req = true and refuses
     * it. Such a key must not be advertised anywhere, so clients
     * cannot bind to a key whose recovery would always fail. */
    int have_unrestricted = 0;
    json_auto_t* unrestricted = jwk_generate("ML-KEM-768");
    if (unrestricted) {
        json_object_del(unrestricted, "key_ops");
        json_object_del(unrestricted, "use");
        char unrestricted_path[PATH_MAX];
        snprintf(unrestricted_path, PATH_MAX, "%s/unrestricted_akp.jwk",
                 newdir);
        ASSERT(json_dump_file(unrestricted, unrestricted_path, 0) == 0);
        have_unrestricted = 1;
    }

    __attribute__((cleanup(cleanup_tang_keys_info))) struct tang_keys_info* tki =
        read_keys(newdir);
    ASSERT(tki);
    ASSERT(tki->m_keys_count == (size_t)(2 + 1 + have_unrestricted));

    size_t idx;
    json_t* jwk;
    json_array_foreach(tki->m_payload, idx, jwk) {
        const char* kty = json_string_value(json_object_get(jwk, "kty"));
        ASSERT_WITH_MSG(kty && strcmp(kty, "AKP") != 0,
                        "AKP key leaked into the classical payload");
    }
    json_array_foreach(tki->m_sign, idx, jwk) {
        const char* kty = json_string_value(json_object_get(jwk, "kty"));
        ASSERT_WITH_MSG(kty && strcmp(kty, "AKP") != 0,
                        "AKP key leaked into the signing set");
    }
    json_array_foreach(tki->m_kem_payload, idx, jwk) {
        const char* alg = json_string_value(json_object_get(jwk, "alg"));
        ASSERT_WITH_MSG(alg && strncmp(alg, "ML-KEM-", 7) == 0,
                        "non-KEM AKP key leaked into the KEM payload");
    }
    /* No AKP key may be advertised: the ML-DSA one has no supported
     * KEM algorithm and the unrestricted one fails the req = true
     * deriveKey predicate that /rec-kem enforces. */
    ASSERT(json_array_size(tki->m_kem_payload) == 0);
    ASSERT(tki->m_has_pqc == 0);

    /* The rogue keys must not break advertisement signing. */
    json_auto_t* jws = jwk_sign(tki->m_payload, tki->m_sign);
    ASSERT_WITH_MSG(jws, "rogue AKP keys broke advertisement signing");

    remove_tempdir(newdir);
    umask(old_umask);
}

/* Counterpart of the rogue-key test: a hand-crafted AKP key with a
 * supported ML-KEM algorithm, the right key_ops and complete key
 * material must be advertised in the KEM payload. Hand-crafting the
 * JWK keeps the acceptance path of prepare_payload_and_sign() covered
 * even when jose itself cannot generate ML-KEM keys (builds without
 * PQC support); the material is fabricated because read_keys() only
 * classifies the key, and real generated keys are covered by
 * test_read_keys_with_kem. */
static void
test_read_keys_with_advertised_akp(void)
{
    mode_t old_umask = umask(0022);
    __attribute__((cleanup(cleanup_str))) char* newdir = create_tempdir();
    ASSERT(newdir);

    json_auto_t* sig = jwk_generate("ES512");
    ASSERT(sig);
    char sig_path[PATH_MAX];
    snprintf(sig_path, PATH_MAX, "%s/sig.jwk", newdir);
    ASSERT(json_dump_file(sig, sig_path, 0) == 0);

    json_auto_t* exc = jwk_generate("ECMR");
    ASSERT(exc);
    char exc_path[PATH_MAX];
    snprintf(exc_path, PATH_MAX, "%s/exc.jwk", newdir);
    ASSERT(json_dump_file(exc, exc_path, 0) == 0);

    json_auto_t* kem = json_pack(
        "{s:s, s:s, s:s, s:s, s:[s]}",
        "kty", "AKP",
        "alg", KEM_ALG_768,
        "pub", "ML-KEM-fabricated-public-material",
        "priv", "ML-KEM-fabricated-private-material",
        "key_ops", "deriveKey");
    ASSERT(kem);
    char kem_path[PATH_MAX];
    snprintf(kem_path, PATH_MAX, "%s/kem.jwk", newdir);
    ASSERT(json_dump_file(kem, kem_path, 0) == 0);

    __attribute__((cleanup(cleanup_tang_keys_info))) struct tang_keys_info* tki =
        read_keys(newdir);
    ASSERT(tki);
    ASSERT(tki->m_keys_count == 3);
    ASSERT(tki->m_has_pqc == 1);
    ASSERT(json_array_size(tki->m_kem_payload) == 1);
    ASSERT(json_array_size(tki->m_payload) == 2);
    ASSERT(json_array_size(tki->m_sign) == 1);

    json_t* advertised = json_array_get(tki->m_kem_payload, 0);
    ASSERT(advertised);
    const char* alg = json_string_value(json_object_get(advertised, "alg"));
    ASSERT_WITH_MSG(alg && strcmp(alg, KEM_ALG_768) == 0,
                    "advertised alg = %s", alg);

    remove_tempdir(newdir);
    umask(old_umask);
}

/* A public-only AKP key (e.g. the output of "jose jwk pub" restored
 * into the key directory) must not be advertised, whatever its
 * key_ops are: clients could bind to it, since encapsulation only
 * needs the public part, but decapsulation could only ever fail. */
static void
test_read_keys_with_public_only_akp(void)
{
    mode_t old_umask = umask(0022);
    __attribute__((cleanup(cleanup_str))) char* newdir = create_tempdir();
    ASSERT(newdir);

    json_auto_t* sig = jwk_generate("ES512");
    ASSERT(sig);
    char sig_path[PATH_MAX];
    snprintf(sig_path, PATH_MAX, "%s/sig.jwk", newdir);
    ASSERT(json_dump_file(sig, sig_path, 0) == 0);

    json_auto_t* exc = jwk_generate("ECMR");
    ASSERT(exc);
    char exc_path[PATH_MAX];
    snprintf(exc_path, PATH_MAX, "%s/exc.jwk", newdir);
    ASSERT(json_dump_file(exc, exc_path, 0) == 0);

    json_auto_t* pubonly = json_pack(
        "{s:s, s:s, s:s, s:[s]}",
        "kty", "AKP",
        "alg", KEM_ALG_768,
        "pub", "ML-KEM-fabricated-public-material",
        "key_ops", "deriveKey");
    ASSERT(pubonly);
    char pubonly_path[PATH_MAX];
    snprintf(pubonly_path, PATH_MAX, "%s/pubonly.jwk", newdir);
    ASSERT(json_dump_file(pubonly, pubonly_path, 0) == 0);

    __attribute__((cleanup(cleanup_tang_keys_info))) struct tang_keys_info* tki =
        read_keys(newdir);
    ASSERT(tki);
    ASSERT(tki->m_keys_count == 3);
    ASSERT(json_array_size(tki->m_kem_payload) == 0);
    ASSERT(tki->m_has_pqc == 0);

    /* The predicate itself: NULL and public-only keys are rejected. */
    ASSERT(jwk_valid_for_kem_exchange(NULL) == 0);
    ASSERT(jwk_valid_for_kem_exchange(pubonly) == 0);

    /* The classical advertisement must remain fully working. */
    json_auto_t* jws = jwk_sign(tki->m_payload, tki->m_sign);
    ASSERT_WITH_MSG(jws, "public-only AKP key broke advertisement signing");

    remove_tempdir(newdir);
    umask(old_umask);
}

/* A key store without signing keys cannot produce a signed
 * advertisement: read_keys() must fail instead of advertising an
 * unsigned payload. */
static void
test_read_keys_no_signing_keys(void)
{
    mode_t old_umask = umask(0022);
    __attribute__((cleanup(cleanup_str))) char* newdir = create_tempdir();
    ASSERT(newdir);

    json_auto_t* exc = jwk_generate("ECMR");
    ASSERT(exc);
    char exc_path[PATH_MAX];
    snprintf(exc_path, PATH_MAX, "%s/exc.jwk", newdir);
    ASSERT(json_dump_file(exc, exc_path, 0) == 0);

    __attribute__((cleanup(cleanup_tang_keys_info))) struct tang_keys_info* tki =
        read_keys(newdir);
    ASSERT_WITH_MSG(tki == NULL,
                    "read_keys must fail when no signing keys exist");

    remove_tempdir(newdir);
    umask(old_umask);
}

/* A hand-edited public-only signing key -- "d" removed, key_ops
 * kept, so unlike the output of "jose jwk pub" it still passes the
 * permission checks -- must not be admitted as the active signer:
 * nothing can produce a signature with it. With a complete deriving
 * key in the store the healing trigger stays quiet, so read_keys()
 * fails and every endpoint, /version included, answers 500 -- the
 * broken-store signal -- instead of /adv and /adv-kem answering 404
 * while /version keeps saying 200. */
static void
test_read_keys_public_only_signer_fails(void)
{
    mode_t old_umask = umask(0022);
    __attribute__((cleanup(cleanup_str))) char* newdir = create_tempdir();
    ASSERT(newdir);

    json_auto_t* pub_only = jwk_generate("ES512");
    ASSERT(pub_only);
    json_object_del(pub_only, "d");
    char pub_only_path[PATH_MAX];
    snprintf(pub_only_path, PATH_MAX, "%s/pubonly.jwk", newdir);
    ASSERT(json_dump_file(pub_only, pub_only_path, 0) == 0);

    /* A complete deriving key keeps the healing trigger quiet, so
     * the failure can only come from the missing usable signer. */
    json_auto_t* exc = jwk_generate("ECMR");
    ASSERT(exc);
    char exc_path[PATH_MAX];
    snprintf(exc_path, PATH_MAX, "%s/exc.jwk", newdir);
    ASSERT(json_dump_file(exc, exc_path, 0) == 0);

    __attribute__((cleanup(cleanup_tang_keys_info))) struct tang_keys_info* tki =
        read_keys(newdir);
    ASSERT_WITH_MSG(tki == NULL,
                    "a store whose only signer cannot sign must fail "
                    "read_keys");

    remove_tempdir(newdir);
    umask(old_umask);
}

/* The same public-only signer next to a complete one: the store
 * keeps serving, and the unusable key is neither used for signing
 * nor advertised -- jose_jws_sig is all-or-nothing over m_sign, so
 * admitting it would take /adv and /adv-kem down with it. */
static void
test_read_keys_public_only_signer_ignored(void)
{
    mode_t old_umask = umask(0022);
    __attribute__((cleanup(cleanup_str))) char* newdir = create_tempdir();
    ASSERT(newdir);

    json_auto_t* sig = jwk_generate("ES512");
    ASSERT(sig);
    char sig_path[PATH_MAX];
    snprintf(sig_path, PATH_MAX, "%s/sig.jwk", newdir);
    ASSERT(json_dump_file(sig, sig_path, 0) == 0);

    json_auto_t* pub_only = jwk_generate("ES512");
    ASSERT(pub_only);
    json_object_del(pub_only, "d");
    __attribute__((cleanup(cleanup_str))) char* pub_only_thp =
        jwk_thumbprint(pub_only, "S256");
    ASSERT(pub_only_thp);
    char pub_only_path[PATH_MAX];
    snprintf(pub_only_path, PATH_MAX, "%s/pubonly.jwk", newdir);
    ASSERT(json_dump_file(pub_only, pub_only_path, 0) == 0);

    json_auto_t* exc = jwk_generate("ECMR");
    ASSERT(exc);
    char exc_path[PATH_MAX];
    snprintf(exc_path, PATH_MAX, "%s/exc.jwk", newdir);
    ASSERT(json_dump_file(exc, exc_path, 0) == 0);

    __attribute__((cleanup(cleanup_tang_keys_info))) struct tang_keys_info* tki =
        read_keys(newdir);
    ASSERT_WITH_MSG(tki, "a usable signer must keep the store alive");
    ASSERT(tki->m_keys_count == 3);
    ASSERT_WITH_MSG(json_array_size(tki->m_sign) == 1,
                    "the public-only key must not be in the signing set");

    /* Not advertised either: a client pinning it as a verify key
     * could never verify an advertisement again. */
    size_t idx;
    json_t* jwk;
    json_array_foreach(tki->m_payload, idx, jwk) {
        __attribute__((cleanup(cleanup_str))) char* thp =
            jwk_thumbprint(jwk, "S256");
        ASSERT_WITH_MSG(thp && strcmp(thp, pub_only_thp) != 0,
                        "public-only signing key advertised in the payload");
    }

    /* The default advertisement is produced and verifies. */
    json_auto_t* adv = find_jws(tki, NULL);
    ASSERT_WITH_MSG(adv, "an unusable active signer took down /adv");
    ASSERT(jose_jws_ver(NULL, adv, NULL, tki->m_sign, 1));

    remove_tempdir(newdir);
    umask(old_umask);
}

static void
test_find_by_thp_null(void)
{
    ASSERT(find_by_thp(NULL, "anything") == NULL);

    __attribute__((cleanup(cleanup_str))) char *tmpdir = copy_fixture();
    ASSERT(tmpdir);
    __attribute__((cleanup(cleanup_tang_keys_info)))
        struct tang_keys_info *tki = read_keys(tmpdir);
    ASSERT(tki);

    ASSERT(find_by_thp(tki, "nonexistent-thumbprint") == NULL);

    remove_tempdir(tmpdir);
}

static void
run_tests(void)
{
    test_read_keys();
    test_find_jwk();
    test_find_jws();
    test_jwk_generate();
    test_is_hash();
    test_create_new_keys();
    test_cleanup_null();
    test_jwk_sign_null_inputs();
    test_jwk_sign_no_signing_key();
    test_read_keys_with_kem();
    test_create_new_keys_kem_variants();
    test_jwk_thumbprint_edge_cases();
    test_jwk_thumbprint_missing_members();
    test_prepare_payload_and_sign_null();
    test_find_by_thp_null();
    test_read_keys_with_rogue_akp();
    test_read_keys_with_advertised_akp();
    test_read_keys_with_public_only_akp();
    test_read_keys_partial_store_regenerates();
    test_read_keys_public_only_exc_not_advertised();
    test_read_keys_public_only_exc_heals();
    test_read_keys_no_signing_keys();
    test_read_keys_public_only_signer_fails();
    test_read_keys_public_only_signer_ignored();
    test_read_keys_alg_removed_exc_not_advertised();
    test_read_keys_alg_removed_exc_heals();
    test_is_valid_kem_alg();
    test_create_new_keys_save_failure();
    test_create_new_keys_rollback();
    test_create_new_keys_rollback_complete_file();
}

int main(int argc, char** argv)
{
    run_tests();
    return 0;
}
